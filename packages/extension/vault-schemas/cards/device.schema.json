{
  "$id": "https://schemas.amicode.dev/vault/cards/device.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance_unrecoverable": {
            "const": true
          }
        },
        "required": [
          "provenance_unrecoverable"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "maxItems": 0
          }
        },
        "required": [
          "reviewed_after"
        ]
      }
    }
  ],
  "properties": {
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "device_class": {
      "enum": [
        "classical",
        "quantum"
      ]
    },
    "location": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance_unrecoverable": {
      "type": "boolean"
    },
    "review_by": {
      "format": "date",
      "type": "string"
    },
    "reviewed_after": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "online",
        "offline",
        "maintenance"
      ]
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "type": {
      "const": "device"
    }
  },
  "required": [
    "type",
    "name",
    "status",
    "device_class",
    "platforms",
    "location",
    "tags"
  ],
  "title": "device card",
  "type": "object"
}
