{
  "$id": "https://schemas.amicode.dev/vault/cards/spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance_unrecoverable": {
            "const": true
          }
        },
        "required": [
          "provenance_unrecoverable"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "maxItems": 0
          }
        },
        "required": [
          "reviewed_after"
        ]
      }
    }
  ],
  "properties": {
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "linked_plan": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance_unrecoverable": {
      "type": "boolean"
    },
    "review_by": {
      "format": "date",
      "type": "string"
    },
    "reviewed_after": {
      "minLength": 1,
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "in-progress",
        "completed",
        "abandoned"
      ]
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "type": {
      "const": "spec"
    },
    "visibility": {
      "enum": [
        "local",
        "team",
        "public"
      ]
    }
  },
  "required": [
    "type",
    "date",
    "session_id",
    "status",
    "tags",
    "visibility"
  ],
  "title": "spec card",
  "type": "object"
}
