{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "smol-toml": ["./node_modules/smol-toml"],
      "yaml": ["./node_modules/yaml"],
      "@amicode/schema": ["./node_modules/@amicode/schema/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
